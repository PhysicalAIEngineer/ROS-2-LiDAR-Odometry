<?xml version="1.0"?>
<package format="3">
  <name>simple_lidar_odometry</name>
  <version>0.2.0</version>
  <description>ROS 2 LiDAR odometry using Open3D point-to-plane ICP for sequential point-cloud motion estimation.</description>

  <maintainer email="chetansonigara01@gmail.com">PhysicalAIEngineer</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
